# Copy to .env.production on the server and fill in. NEVER commit the real file.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production

# --- domain / TLS -------------------------------------------------------
DOMAIN=api.yourschool.com
TLS_EMAIL=ops@yourschool.com

# --- database -----------------------------------------------------------
# generate: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_USER=school
MYSQL_PASSWORD=

# --- app ----------------------------------------------------------------
# generate: openssl rand -hex 32
SECRET_KEY=
TOKEN_EXPIRE_HOURS=24

# uvicorn worker processes -- roughly 2x vCPU for this blocking-DB workload
WEB_CONCURRENCY=4
