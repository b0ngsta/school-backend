# copy to .env and edit (local development)
APP_ENV=development
DATABASE_URL="mysql+pymysql://root:yourpassword@localhost:3306/school_app"
SECRET_KEY="change-this-to-a-long-random-string"   # openssl rand -hex 32
UPLOAD_DIR="uploads"

# --- optional (defaults shown) ------------------------------------------
# APP_TIMEZONE=Asia/Kolkata            # "today", check-in times, CURDATE()
# ACCESS_TOKEN_EXPIRE_MINUTES=15       # short-lived; clients renew via /auth/refresh
# REFRESH_TOKEN_IDLE_DAYS=30           # stay logged in while the app is used at least monthly
# REFRESH_TOKEN_MAX_DAYS=180           # re-login at least every 6 months
# REFRESH_REUSE_GRACE_SECONDS=60       # parallel refreshes after the app wakes up
# MAX_SESSIONS_PER_USER=10             # devices per account
# ENFORCE_PASSWORD_CHANGE=false        # block seeded/default passwords until changed
# CORS_ORIGINS=https://admin.yourschool.com   # comma separated; dev default is *
# ENABLE_DOCS=true                     # /docs (on by default in development only)
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt   # TLS for remote DBs (TiDB); "" to disable
# DB_POOL_SIZE=10
# FILE_URL_TTL_HOURS=24                # lifetime of signed links to uploaded files

# --- email (password-reset codes) -----------------------------------------
# Without SMTP_HOST emails are only written to the log (development).
# SCHOOL_NAME="Green Valley School"            # shown in email subjects and as sender name
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com  # SES Mumbai; or smtp.zeptomail.in, smtp-relay.brevo.com, smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls                       # starttls (587) | ssl (465) | none (local relay only)
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
# EMAIL_FROM="Green Valley School <no-reply@greenvalley.edu.in>"
# REQUIRE_USER_EMAIL=false             # true once the frontend makes email mandatory on user forms
# RESET_CODE_TTL_MINUTES=15
# RESET_CODE_MAX_ATTEMPTS=5            # wrong guesses per code
# RESET_MAX_WRONG_CODES_PER_DAY=20     # per account, across codes
# RESET_MAX_CODES_PER_ACCOUNT=5        # requests per username/email per RESET_WINDOW_MINUTES
# RESET_MAX_REQUESTS_PER_IP=100        # per RESET_WINDOW_MINUTES
# RESET_WINDOW_MINUTES=60

# --- bulk user import (CSV + photos ZIP) ----------------------------------
# IMPORT_MAX_ROWS=1000
# IMPORT_MAX_CSV_MB=2
# IMPORT_MAX_ZIP_MB=100

# --- uploads: local disk (default) or an S3-compatible bucket ------------
# REQUIRED on Render (and any host without a persistent disk): local files are wiped on every
# deploy/restart/sleep, so uploads vanish. Check with `python -m app.cli check-storage`.
# STORAGE_BACKEND=s3
# S3_BUCKET=school-uploads
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # R2 / OCI / MinIO; leave empty for AWS
# S3_REGION=auto                                               # e.g. ap-south-1, ap-hyderabad-1, auto (R2)
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PREFIX=                                                   # optional folder inside the bucket
# EPHEMERAL_DISK=true                  # warn at startup if uploads are on a throwaway disk (auto on Render)

# --- logs & error tracking -----------------------------------------------
# LOG_FORMAT=text                      # json in production by default
# LOG_LEVEL=INFO
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=0          # e.g. 0.05 for 5% performance tracing

# --- notifications & scheduled jobs ---------------------------------------
# FIREBASE_CREDENTIALS=/run/secrets/firebase.json   # FCM service account (file path or the JSON itself); unset = no push
# JOBS_SECRET=...                      # enables POST /internal/jobs/fee-reminders (header X-Jobs-Secret); run daily ~08:00
# SCHOOL_TZ=Asia/Kolkata               # same as APP_TIMEZONE (used if APP_TIMEZONE isn't set)

# --- organisations (several schools on one API) ---------------------------
# Every login names a school code ("org_code"). Requests without one use DEFAULT_ORG_CODE, so
# apps released before school codes keep working; set it empty to make the code mandatory.
# DEFAULT_ORG_CODE=DEFAULT             # the school that existed before migration 0009 gets this code
# PLATFORM_SECRET=...                  # enables /platform/* (header X-Platform-Secret): the owner portal (work/dashboard)
#                                      # uses it to watch every school, add schools, reset accounts. `openssl rand -hex 32`

# --- container start ------------------------------------------------------
# MIGRATE_ON_START=true                # run `alembic upgrade head` before serving
